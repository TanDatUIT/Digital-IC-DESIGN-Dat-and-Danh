{NETLIST full_adder
{VERSION 1 0 0}

/* Level 1 */

{CELL NAND2_2
	{PORT N_2 gnd! vdd! N_17 N_20 N_23 N_25}
	{PROP top=12.720000 bottom=5.125000 left=-10.970000 right=-8.325000}
	{INST M1=N {PROP x=-9.775 y=6.655  l=0.100 w=0.240}
		{PIN N_20=GATE N_7=SRC gnd!=DRN N_23=BULK }}
	{INST M2=N {PROP x=-9.425 y=6.655  l=0.100 w=0.240}
		{PIN N_17=GATE N_2=SRC N_7=DRN N_23=BULK }}
	{INST M3=P {PROP x=-9.945 y=11.425  l=0.100 w=0.300}
		{PIN N_20=GATE N_2=SRC vdd!=DRN N_25=BULK }}
	{INST M4=P {PROP x=-9.595 y=11.425  l=0.100 w=0.300}
		{PIN N_17=GATE vdd!=SRC N_2=DRN N_25=BULK }}
}

/* Level 0 */

