{NETLIST CMOS_NEW
{VERSION 1 0 0}

/* Level 0 */

{CELL CMOS_NEW
	{PORT vdd! out gnd! in}
	{PROP top=4.010000 bottom=-0.750000 left=-1.310000 right=-0.230000}
	{INST M1=N {PROP x=-0.770 y=0.520  l=0.180 w=0.360}
		{PIN in=GATE out=SRC gnd!=DRN N_9=BULK }}
	{INST M2=P {PROP x=-0.770 y=2.060  l=0.180 w=1.800}
		{PIN in=GATE out=SRC vdd!=DRN N_12=BULK }}
}
}
