<module name="vsl: inverter TB_CMOS schematic vl: hspice hspiceD cmos.sch cmos_sch schematic veriloga">
<scope name="Instance">
<forward>
<mapping src="I0" dst="xi0"/>
<mapping src="I8" dst="xi8"/>
<mapping src="V4" dst="v4"/>
<mapping src="I9" dst="xi9"/>
<mapping src="V1" dst="v1"/>
<mapping src="C6" dst="c6"/>
</forward>
<reverse>
<mapping src="xi8" dst="I8"/>
<mapping src="xi9" dst="I9"/>
<mapping src="xi0" dst="I0"/>
<mapping src="v1" dst="V1"/>
<mapping src="v4" dst="V4"/>
<mapping src="c6" dst="C6"/>
</reverse>
</scope>
<scope name="Net">
<forward/>
<reverse/>
</scope>
<scope name="Terminal">
<forward>
<mapping src="&lt;termOrder>" dst="out"/>
<mapping src="&lt;unmappedTermOrder>" dst="out"/>
</forward>
<reverse>
<mapping src="out" dst="&lt;unmappedTermOrder>"/>
</reverse>
</scope>
<master_instances>
<instance_header master="cap">
<instance name="C6"/>
</instance_header>
<instance_header master="cmos">
<instance name="I0"/>
<instance name="I8"/>
<instance name="I9"/>
</instance_header>
<instance_header master="vdc">
<instance name="V1"/>
</instance_header>
<instance_header master="vpulse">
<instance name="V4"/>
</instance_header>
</master_instances>
</module>
