{net_global vdd! gnd! }
{cell NAND2_2
{port A B Y}
{inst MM2=N
{prop M=1 NF=1 L=0.1 W=0.24}
{pin Y=DRN A=GATE net19=SRC gnd!=BULK}}
{inst MM3=N
{prop M=1 NF=1 L=0.1 W=0.24}
{pin net19=DRN B=GATE gnd!=SRC gnd!=BULK}}
{inst MM0=P
{prop M=1 NF=1 L=0.1 W=0.3}
{pin Y=DRN B=GATE vdd!=SRC vdd!=BULK}}
{inst MM1=P
{prop M=1 NF=1 L=0.1 W=0.3}
{pin Y=DRN A=GATE vdd!=SRC vdd!=BULK}}
}

{cell NAND2
{inst MM2=N
{prop M=1 NF=1 L=0.1 W=0.24}
{pin Y=DRN in1=GATE net13=SRC net13=BULK}}
{inst MM3=N
{prop M=1 NF=1 L=0.1 W=0.24}
{pin net13=DRN in2=GATE gnd!=SRC gnd!=BULK}}
{inst MM0=P
{prop M=1 NF=1 L=0.1 W=0.3}
{pin Y=DRN in1=GATE vdd!=SRC vdd!=BULK}}
{inst MM1=P
{prop M=1 NF=1 L=0.1 W=0.3}
{pin Y=DRN in2=GATE vdd!=SRC vdd!=BULK}}
}

{cell MOSVAR_1V2
{port PLUS MINUS BULK}
}

{cell NDN25
{port DRN GATE SRC PW PSUB DNW}
{inst q2=DNWPNP
{pin PW=COLL PSUB=BASE DNW=EMIT}}
{inst m1=N25
{pin D=DRN G=GATE S=SRC PW=BULK}}
}

