<module name="vsl: inverter LAB3_NAND2 schematic vl: auCdl schematic symbol">
<scope name="Instance">
<forward>
<mapping dst="MM2" src="M2"/>
<mapping dst="MM0" src="M0"/>
<mapping dst="MM3" src="M3"/>
<mapping dst="MM1" src="M1"/>
</forward>
<reverse>
<mapping dst="M2" src="MM2"/>
<mapping dst="M3" src="MM3"/>
<mapping dst="M0" src="MM0"/>
<mapping dst="M1" src="MM1"/>
</reverse>
</scope>
<scope name="Net">
<forward/>
<reverse/>
</scope>
<scope name="Terminal">
<forward>
<mapping dst="A B Y" src="&lt;unmappedTermOrder>"/>
<mapping dst="A B Y" src="&lt;termOrder>"/>
</forward>
<reverse>
<mapping dst="&lt;unmappedTermOrder>" src="A B Y"/>
</reverse>
</scope>
<master_instances>
<instance_header master="n_4t">
<instance name="M2"/>
<instance name="M3"/>
</instance_header>
<instance_header master="p_4t">
<instance name="M0"/>
<instance name="M1"/>
</instance_header>
</master_instances>
</module>
