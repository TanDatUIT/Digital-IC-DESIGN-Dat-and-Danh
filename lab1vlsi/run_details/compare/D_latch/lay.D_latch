{NETLIST D_latch
{VERSION 1 0 0}

{CELL D_latch
    {PORT vdd! gnd! CLK Q CLKB D }
    {INST M6=P {PROP n="P" x=10.150 y=6.020 Length=0.1 Width=0.3 }
	{PIN N_2=GATE vdd!=SRC N_10=DRN }}
    {INST M5=P {PROP n="P" x=11.080 y=5.960 Length=0.1 Width=0.42 }
	{PIN N_10=GATE Q=SRC vdd!=DRN }}
    {INST M4=N {PROP n="N" x=10.150 y=3.365 Length=0.1 Width=0.12 }
	{PIN N_2=GATE gnd!=SRC N_10=DRN }}
    {INST M3=N {PROP n="N" x=11.080 y=3.365 Length=0.1 Width=0.18 }
	{PIN N_10=GATE Q=SRC gnd!=DRN }}
    {INST M2=N {PROP n="N" x=9.090 y=3.370 Length=0.1 Width=0.18 }
	{PIN CLK=GATE N_2=SRC D=DRN }}
    {INST M1=N {PROP n="N" x=8.010 y=3.335 Length=0.1 Width=0.12 }
	{PIN CLKB=GATE Q=SRC N_2=DRN }}
    {INST M8=P {PROP n="P" x=9.165 y=6.020 Length=0.1 Width=0.28 }
	{PIN CLKB=GATE N_2=SRC D=DRN }}
    {INST M7=P {PROP n="P" x=8.080 y=6.040 Length=0.1 Width=0.2 }
	{PIN CLK=GATE Q=SRC N_2=DRN }}
}
}
