{NETLIST NAND2_2
{VERSION 1 0 0}

{CELL NAND2_2
    {PORT A vdd! gnd! B S }
    {INST M2=N {PROP n="N" x=-3.690 y=4.760 Length=0.1 Width=0.24 }
	{PIN B=GATE S=SRC N_5=DRN }}
    {INST M1=N {PROP n="N" x=-4.040 y=4.760 Length=0.1 Width=0.24 }
	{PIN A=GATE N_5=SRC gnd!=DRN }}
    {INST M4=P {PROP n="P" x=-3.865 y=7.275 Length=0.1 Width=0.3 }
	{PIN B=GATE vdd!=SRC S=DRN }}
    {INST M3=P {PROP n="P" x=-4.215 y=7.275 Length=0.1 Width=0.3 }
	{PIN A=GATE S=SRC vdd!=DRN }}
}
}
