{NETLIST CMOS
{VERSION 1 0 0}

/* Level 0 */

{CELL CMOS
	{PORT gnd vdd out in}
	{PROP top=1.640000 bottom=-1.660000 left=1.390000 right=3.200000}
	{INST M1=N {PROP x=2.225 y=-0.665  l=0.180 w=0.120}
		{PIN in=GATE out=SRC gnd=DRN N_9=BULK }}
	{INST M2=P {PROP x=2.225 y=0.400  l=0.180 w=0.420}
		{PIN in=GATE out=SRC vdd=DRN N_11=BULK }}
}
}
