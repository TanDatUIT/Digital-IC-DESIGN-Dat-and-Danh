{NETLIST LAB3_NAND2
{VERSION 1 0 0}

{CELL LAB3_NAND2
    {PORT gnd! vdd! N_3 }
    {INST M2=N {PROP n="N" x=1.890 y=-0.070 Length=0.1 Width=0.24 }
	{PIN N_17=GATE N_2=SRC gnd!=DRN }}
    {INST M1=N {PROP n="N" x=2.240 y=-0.070 Length=0.1 Width=0.24 }
	{PIN N_18=GATE N_3=SRC N_2=DRN }}
    {INST M4=P {PROP n="P" x=1.720 y=4.700 Length=0.1 Width=0.3 }
	{PIN N_17=GATE N_3=SRC vdd!=DRN }}
    {INST M3=P {PROP n="P" x=2.070 y=4.700 Length=0.1 Width=0.3 }
	{PIN N_18=GATE vdd!=SRC N_3=DRN }}
}
}
